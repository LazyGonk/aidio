# OpenAI-compatible endpoint (e.g. LM Studio, llama.cpp, LiteLLM gateway)
OPENAI_BASE_URL=http://127.0.0.1:4000/v1
OPENAI_API_KEY=sk-not-needed-for-local

# Model to use for audio analysis
ANALYSIS_MODEL=gemma4:12b

# Power users: replace the entire system prompt used for LLM lyric
# correction (--llm-correct CLI flag or the web UI's "Polish lyrics"
# button). Leave unset for the built-in prompt. The web UI's optional
# "Polish notes" field appends instructions instead of replacing it.
# AIDIO_CORRECTION_PROMPT=

# Default sample rate the model expects (Hz)
MODEL_SAMPLE_RATE=16000

# Maximum audio duration to process in one call (seconds).
# Beyond this, audio is chunked.
MAX_CHUNK_SECONDS=2400

# Transcription device: cuda (default) | cpu | rocm (Linux only)
AIDIO_DEVICE=cuda

# Remote Whisper backend (only when using --backend remote)
WHISPER_URL=http://localhost:2389/v1
WHISPER_MODEL=large-v3-turbo
WHISPER_API_KEY=

# Whisper pipeline options are CLI/web flags:
#   --model large-v3-turbo --separate-vocals --timestamps --llm-correct
